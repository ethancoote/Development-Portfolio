---
const { role, company, years, content = "" } = Astro.props;
---

<div class="flex flex-col bg-neutral-800 rounded-lg border-1 border-neutral-700">
    <div class="flex flex-col text-xl gap-1 p-6">
        <p class="text-neutral-100 text-2xl">{role}</p>
        <p class="text-neutral-400 text-lg">{years}</p>
        <p class="text-neutral-300 text-xl">{company}</p>
    </div>
    <div class="flex flex-col w-full h-fit text-neutral-400 text-md sm:text-lg p-6 sm:p-6 bg-neutral-900 rounded-bl-lg rounded-br-lg gap-1">
        {content !== "" && <p>{content}</p>}

        {company === "Dr. Marketing" && 
            <ul class="list-disc sm:pl-8 pl-5 flex-col flex gap-4 sm:gap-2">
                <li>Worked with a small team to design, develop, and launch websites for medical practices.</li>
                <li>Developed internal web tools using Python, Flask, JavaScript, Node.js, HTML, and CSS.</li>
                <li>Managed domain transfers, DNS configuration, and website launches.</li>
            </ul>
        }

        {company === "Independent Contractor" && 
            <ul class="list-disc sm:pl-8 pl-5 flex-col flex gap-4 sm:gap-2">
                <li>Designed, developed, and maintained responsive websites for businesses in Canada, United Kingdom, United States, and India. </li>
                <li>Provided on-page and technical SEO through site audits and implementation of best practices.</li>
                <li>Modified and optimized websites for performance, meeting benchmarks for core web vital (LCP, TBT, etc.) </li>
                <li>Ensured timely delivery of high quality work while maintaining excellent customer communication and satisfaction. </li>
            </ul>
        }

        {company === "Semtech" &&
            <ul class="list-disc sm:pl-8 pl-5  flex-col flex gap-4 sm:gap-2">
                <li>Collaborated with a large team to develop web-based tools to improve engineering workflow. </li>
                <li>Developed systems connecting web tools with GitLab servers to integrate data and send merge requests automatically.  </li>
                <li>Designed and developed a full stack web tool using Python, Flask, HTML and CSS. </li>
            </ul>
        }
        
    </div>
</div>